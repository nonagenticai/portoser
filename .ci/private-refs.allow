# Allowlist for scripts/no-private-refs.sh
#
# Every rule here is a place where `<name>.internal` is portoser's OWN DNS
# convention, not a reference to the live estate. Rules are deliberately
# narrow: a new estate hostname (e.g. "kag.internal") matches none of these
# and still fails the guard.
#
# Format: path/glob:REGEX   # justification

# The deployment tool's own default database hostnames (prod/test modes are
# generated by portoser itself; postgres/pgbouncer/neo4j are public products).
lib/databases.sh:(postgres|pgbouncer|neo4j)(-(prod|test))?\\?\.internal|\*\.internal

# Default dependency hostnames baked into deploy orchestration: public
# products (pgbouncer, Keycloak) plus Docker's standard host alias.
lib/intelligent_deploy.sh:(pgbouncer|keycloak|host\.docker)\.internal

# Health-check helper documentation examples.
lib/cluster/health.sh:myservice\.internal

# Default hostname generated from a service name by the registry.
lib/registry.sh:service(_name)?\.internal

# Default hostname derived for an undeclared service dependency.
lib/dependencies/analyzer.sh:\$service\.internal

# YAML key name (`internal_port`), not a hostname.
lib/utils/service_detection.sh:\.internal_port

# Wildcard DNS checks and the local test fixture.
lib/dns.sh:\*\.internal|test\.internal
lib/caddyfile_generator.sh:\*\.internal
lib/certificates.sh:\*\.internal
INSTALL.md:\*\.internal

# CLI help: the tool's own `.internal` domain suffix and public product defaults.
portoser:(keycloak\.internal|\.internal domains|service-[a-z]\.internal)

# The illustrative example registry: public products (caddy, keycloak, vault,
# n8n, ...), generic roles (workers, tools, secrets, requirements, procedures)
# and the neutral service-a..service-p placeholders this repo ships.
registry.example.yml:(dnsmasq|caddy|postgres-test|pgbouncer-test|neo4j-test|keycloak|storage|service-a|service-b|postgres-prod|pgbouncer-prod|neo4j-prod|service-c|vault|app-frontend|app-backend|orchestrator|n8n|portoser|portoser-api|service-d|service-e|service-f|service-g|service-h|service-i|service-j|workers|service-k|service-l|tools|secrets|service-m|requirements|procedures|service-n|service-o|service-p)\.internal|\*\.internal

# Same convention in the distribution example's header comment.
service_distribution.example.yml:(keycloak|postgres)\.internal|\*\.internal

# Test fixtures: obviously fake hostnames.
tests/cluster/test_cluster_compose.sh:(test|test-native|test-local)\.internal
tests/lib/cluster/test_health.sh:(test|db)\.internal
tests/lib/test_databases.sh:(postgres|neo4j|pgbouncer)\.internal

# Model field documentation and docker-compose defaults for public products.
web/backend/models/dependencies.py:service\.internal
web/docker-compose.yml:(neo4j|vault)\.internal

# The UI auto-generates `<service-name>.internal`; every hit is the generated
# placeholder form, never a concrete estate hostname.
web/frontend/src/components/ServiceRegistration.jsx:\}\.internal|my-service\.internal|service-name\.internal
